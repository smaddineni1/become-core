{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "paths": {
      "@become/shared": ["../../packages/shared/src"],
      "@become/scoring": ["../../packages/scoring/src"],
      "@become/ai": ["../../packages/ai/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "app/**/*.ts", "app/**/*.tsx"],
  "exclude": ["node_modules"]
}
